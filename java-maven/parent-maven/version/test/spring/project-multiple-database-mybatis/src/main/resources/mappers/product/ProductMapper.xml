<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.company.projectmultipledatabasemybatis.productmapper.ProductMapper">

    <resultMap id="productResultMap" type="com.company.projectmultipledatabasemybatis.model.Product">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="price" column="price"/>
    </resultMap>

    <insert id="insert" parameterType="com.company.projectmultipledatabasemybatis.model.Product">
        INSERT INTO products (id, name, price)
        VALUES (#{id}, #{name}, #{price})
    </insert>

    <select id="findById" resultMap="productResultMap">
        SELECT * FROM products WHERE id = #{id}
    </select>

    <insert id="batchInsert">
        INSERT INTO products (id, name, price)
        VALUES
        <foreach collection="products" item="p" separator=",">
            (#{p.id}, #{p.name}, #{p.price})
        </foreach>
    </insert>

</mapper>
