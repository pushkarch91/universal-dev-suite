<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.company.projectmultipledatabasemybatis.ordermapper.OrderMapper">

    <resultMap id="orderResultMap" type="com.company.projectmultipledatabasemybatis.model.Order">
        <id property="id" column="id"/>
        <result property="orderCode" column="order_code"/>
        <result property="customerName" column="customer_name"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="price" column="price"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.company.projectmultipledatabasemybatis.model.Order">
        INSERT INTO orders (id, order_code, customer_name, product_id, quantity, price, created_at)
        VALUES (#{id}, #{orderCode}, #{customerName}, #{productId}, #{quantity}, #{price}, #{createdAt})
    </insert>

    <select id="findById" resultMap="orderResultMap">
        SELECT * FROM orders WHERE id = #{id}
    </select>

    <insert id="batchInsert">
        INSERT INTO orders (id, order_code, customer_name, product_id, quantity, price, created_at)
        VALUES
        <foreach collection="orders" item="o" separator=",">
            (#{o.id}, #{o.orderCode}, #{o.customerName}, #{o.productId}, #{o.quantity}, #{o.price}, #{o.createdAt})
        </foreach>
    </insert>

</mapper>
